case "$1" in
    start)
        if [ -f "$NOT_FIRST_LAUNCH_F" ]; then
            echo "start() method meant to be only for fresh start!"
            exit 0
        fi

        case "$BOOT_MODE" in
            stock|stock-soft|stock-hard)
                mkdir -p "${SKIP_LOG%/*}"
                restore_stock_config > "$SKIP_LOG" 2>&1
                restore_status=$?

                if [ "$restore_status" -ne 0 ]; then
                    echo "@@ Stock screen setup failed." >> "$SKIP_LOG"
                    echo "?? Starting stock firmware anyway." >> "$SKIP_LOG"
                fi

                report_stock_boot
                exit 0
            ;;
        esac

        start 2>&1 | logged "/data/logFiles/boot.log" --send-to-screen
        # wait_for_internet &
    ;;

    *)
        echo "Usage $0 start"
    ;;
esac

touch "/tmp/boot_$1"
