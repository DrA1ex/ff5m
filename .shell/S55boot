source /opt/config/mod/.shell/boot/boot_mode.sh || exit 0
BOOT_MODE=$(forge_x_boot_mode)

case "$BOOT_MODE" in
    mod|stock|stock-soft|stock-hard)
    ;;

    *)
        echo "Skipping mod boot in $BOOT_MODE mode."
        exit 0
    ;;
esac

source /opt/config/mod/.shell/common.sh

SKIP_LOG=/opt/config/mod_data/log/skip.log
STOCK_CONFIG_TMP=/opt/config/printer.cfg.tmp
STOCK_RESTORE_TIMEOUT_SECONDS=15

apply_stock_config() {
    mount_data_partition
    mount --bind /opt/config "$MOD/opt/config" || return 1
    init_chroot || return $?
    "$CMDS"/zdisplay.sh stock --skip-reboot
}

run_stock_restore() {
    local monitor_was_enabled=0
    local restore_pid
    local seconds=0

    case $- in *m*) monitor_was_enabled=1 ;; esac
    set -m
    apply_stock_config &
    restore_pid=$!
    [ "$monitor_was_enabled" -eq 1 ] || set +m

    while kill -0 "$restore_pid" 2>/dev/null; do
        if [ "$seconds" -ge "$STOCK_RESTORE_TIMEOUT_SECONDS" ]; then
            echo "@@ Stock screen setup timed out."
            echo "?? Limit: $STOCK_RESTORE_TIMEOUT_SECONDS seconds."
            kill -TERM -- "-$restore_pid" 2>/dev/null || true
            sleep 1
            kill -KILL -- "-$restore_pid" 2>/dev/null || true
            wait "$restore_pid" 2>/dev/null || true
            return 124
        fi

        sleep 1
        seconds=$((seconds + 1))
    done

    wait "$restore_pid"
}

restore_stock_config() {
    local data_was_mounted=0
    local restore_status=0

    echo "?? Forge-X is off for this boot."
    [ -s "$BOOT_REASON_F" ] && cat "$BOOT_REASON_F"
    echo "// Preparing the stock screen..."
    echo "// This prevents display conflicts."

    mount | grep -q '/dev/mmcblk0p7' && data_was_mounted=1
    run_stock_restore || restore_status=$?

    echo "// Cleaning up..."
    dispose_chroot
    umount "$MOD/opt/config"
    [ "$data_was_mounted" -eq 1 ] || umount /data

    if [ "$restore_status" -ne 0 ]; then
        rm -f "$STOCK_CONFIG_TMP"
        return "$restore_status"
    fi

    echo "// Stock display configuration is ready."
}

report_stock_boot() {
    [ -f "$SKIP_LOG" ] || return 0
    cat "$SKIP_LOG"

    # Screen reporting is optional and must not hold up the stock boot path.
    logged --no-log --send-to-screen --screen-no-followup \
        < "$SKIP_LOG" > /dev/null 2>&1 &
}

start() {
    /opt/config/mod/.shell/boot/boot.sh

    fstrim -v /root
    fstrim -v /data
}

