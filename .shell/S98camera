source /opt/config/mod/.shell/boot/boot_mode.sh || exit 0
BOOT_MODE=$(forge_x_boot_mode)

case "$BOOT_MODE" in
    mod)
    ;;

    *)
        echo "Custom camera disabled in $BOOT_MODE mode"
        exit 0
    ;;
esac

source /opt/config/mod/.shell/common.sh

CFG_PATH="/opt/config/mod_data/camera.conf"
PID_FILE="$CAMERA_PID_F"

[[ " $* " =~ " --silent " ]] && SILENT=1 || SILENT=0


# Reads camera.conf (creating it from the default on first use).
# Defaults are set before `source` so a config that omits a parameter still gets a sane value.
load_config() {
    [ -f "$CFG_PATH" ] || cp "/opt/config/mod/.cfg/default/camera.conf" "$CFG_PATH"

    WIDTH=640
    HEIGHT=480
    FPS=15
    VIDEO="auto"
    BUFFERS=1
    REDUCE_MEMORY=0

    source "$CFG_PATH"
}

camera_enabled() { [ "$($CFG_SCRIPT "$VAR_PATH" --get "camera" "0")" -eq 1 ]; }

start() {
    echo "Starting camera..."

    if ! camera_enabled; then
        if [ "$SILENT" -eq 0 ]; then echo "Camera disabled in configuration"; fi
        return 0
    fi

    if process_running "$PID_FILE"; then
        echo "Already running"
        return 0
    fi

    load_config

    # "auto" lets the streamer detect the device; otherwise the user's videoN is used.
    local device="/dev/$VIDEO"; [ "$VIDEO" = "auto" ] && device="auto"

    local args=(
        --device "$device"
        --controls-file "$CFG_PATH"
        --resolution "${WIDTH}x${HEIGHT}"
        --fps "$FPS"
        --buffers "$BUFFERS"
        --listen 0.0.0.0
        --port 8080
        --log-file /data/logFiles/streamer.log
    )

    # Some cameras allocate a full-HD sized buffer even at 640x480; --frame-cap limits it.
    # Only an explicit 1 turns it on.
    [ "$REDUCE_MEMORY" = "1" ] && args+=(--frame-cap)

    start-stop-daemon -Sbm -p "$PID_FILE" --exec "$BINS/forge_x_streamer" -- "${args[@]}"
    local status=$?

    if [ "$status" -ne 0 ]; then
        echo "FAIL"
        return "$status"
    fi

    echo "OK"
}

stop() {
    echo "Stopping camera..."
    start-stop-daemon -K -p "$PID_FILE" > /dev/null 2>&1

    # A streamer that ignores the request must not be forgotten: a new one could not take over its port.
    if ! wait_process_exit "$PID_FILE"; then
        echo "Camera did not stop in time, killing it" >&2
        start-stop-daemon -K -s KILL -p "$PID_FILE" > /dev/null 2>&1

        if ! wait_process_exit "$PID_FILE" 1; then
            echo "FAIL"
            return 1
        fi
    fi

    rm -f "$PID_FILE"
    echo "OK"
}

restart() {
    if process_running "$PID_FILE"; then stop || return $?; fi

    start
}

# Rereads the image controls of a running camera. Resolution, fps, device and buffers need `restart`.
reload() {
    if ! camera_enabled; then
        if [ "$SILENT" -eq 0 ]; then
            echo "Camera disabled in configuration."
            echo "To enable the camera, run: SET_MOD PARAM='camera' VALUE=1"
            echo "A detailed guide can be found here: https://github.com/DrA1ex/ff5m/blob/main/docs/CAMERA.md"
        fi

        return 1
    fi

    # Nothing to signal: start it with the current configuration instead.
    if ! process_running "$PID_FILE"; then
        restart
        return $?
    fi

    if ! kill -HUP "$(cat "$PID_FILE")"; then
        echo "Failed to request camera effects reload" >&2
        return 1
    fi

    if [ "$SILENT" -eq 0 ]; then echo "Effects applied"; fi
}


case "$1" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    reload) reload ;;

    *)
        echo "Usage: $0 {start|stop|restart|reload}"
        exit 1
    ;;
esac
