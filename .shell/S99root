source /opt/config/mod/.shell/boot/boot_mode.sh || exit 0
BOOT_MODE=$(forge_x_boot_mode)

case "$BOOT_MODE" in
    mod)
    ;;

    *)
        echo "Buildroot services disabled in $BOOT_MODE mode"
        exit 0
    ;;
esac

source /opt/config/mod/.shell/common.sh

S99ROOT_CALLER_PID=$PPID
S99ROOT_CALLER_CMDLINE="/proc/$S99ROOT_CALLER_PID/cmdline"

system_shutdown_in_progress() {
    [ -r "$S99ROOT_CALLER_CMDLINE" ] || return 1
    tr '\0' '\n' < "$S99ROOT_CALLER_CMDLINE" \
        | grep -Fxq "/etc/init.d/rcK"
}

printer_command_available() {
    [ -e /tmp/printer ] || return 1
    ps | grep -q "[k]lippy.py"
}

if [ -f "$NOT_FIRST_LAUNCH_F" ]; then
    first_launch=0
else
    first_launch=1
fi

start() {
    if [ "$first_launch" -eq 1 ] && [ -f "$CUSTOM_BOOT_F" ]; then
        # Turn off and on display's backlight otherwise it's will not work.
        "$SCRIPTS"/screen.sh backlight 0
        "$SCRIPTS"/screen.sh draw_splash
        "$SCRIPTS"/screen.sh backlight 100

        {
            echo "// Goodbye Flashforge :)"
            kill -9 "$PPID"
        } 2>&1

        sound_enabled=$($CFG_SCRIPT "$VAR_PATH" --get "sound" "1")
        [ "$sound_enabled" -eq 1 ] && midi_file=$($CFG_SCRIPT "$VAR_PATH" --get "midi_on")

        if [ -n "$midi_file" ]; then
            audio midi -m "/opt/config/mod_data/midi/$midi_file" &
        fi

        mount --rbind /dev/pts "$MOD"/dev/pts
    fi

    if ! /opt/config/mod/.shell/migrate_db.sh --check; then
        echo "// Initializing database..."

        rm -f /opt/config/mod/sql/version
        sync

        chroot "$MOD" /opt/config/mod/.root/start.sh &> /dev/null || return 1
        chroot "$MOD" /opt/config/mod/.root/stop.sh &> /dev/null || return 1

        wait_stopped
        sync

        /opt/config/mod/.shell/migrate_db.sh || return 1
        chroot "$MOD" /opt/config/mod/.root/restore_ota.sh || return 1
        sync
    fi

    echo "// Starting Buildroot env..."
    chroot "$MOD" /opt/config/mod/.root/start.sh || return 1

    if [ "$first_launch" -eq 1 ]; then
        echo "// Done. Loaded for $(awk '{print $1}' < /proc/uptime) sec."
        "$SCRIPTS"/screen.sh splash_stop
        echo "// Finishing boot..."
    else
        echo "// Done."
    fi

    rm -f "$SCREEN_FOLLOW_UP_LOG"
    rm -f "$BOOT_FAILURE_F"
    touch "$NOT_FIRST_LAUNCH_F"
}

stop() {
    echo "// Stopping Buildroot env..."
    chroot "$MOD" /opt/config/mod/.root/stop.sh
    echo "// Done"
}

wait_stopped() {
    [ -f "$MOD/run/moonraker.pid" ] \
        && while kill -0 "$(cat "$MOD/run/moonraker.pid")" >/dev/null 2>&1; do sleep 1; done
    [ -f "$MOD/run/httpd.pid" ] \
        && while kill -0 "$(cat "$MOD/run/httpd.pid")" >/dev/null 2>&1; do sleep 1; done
    [ -f "$MOD/run/ntpd.pid" ] \
        && while kill -0 "$(cat "$MOD/run/ntpd.pid")" >/dev/null 2>&1; do sleep 1; done
    [ -f "$MOD/run/guppyscreen.pid" ] \
        && while kill -0 "$(cat "$MOD/run/guppyscreen.pid")" >/dev/null 2>&1; do sleep 1; done
    [ -f "$MOD/var/run/ts_uinput.pid" ] \
        && while kill -0 "$(cat "$MOD/var/run/ts_uinput.pid")" >/dev/null 2>&1; do sleep 1; done
}

restart() {
    stop
    wait_stopped
    start
}

if [ "$first_launch" -eq 1 ]; then
    logged_args=(--send-to-screen --screen-no-followup)
else
    logged_args=(--screen-no-followup)
fi

run_logged() {
    "$@" 2>&1 | logged "/data/logFiles/boot.log" "${logged_args[@]}"
    return "${PIPESTATUS[0]}"
}

case "$1" in
    start)
        run_logged start
        status=$?

        # Release Feather only after the startup logger has closed its output.
        rm -f "$FORGE_X_SCREEN_BUSY_F"
        if printer_command_available; then
            printer_command "action:forge_x_redraw"
        fi
    ;;

    stop)
        system_shutdown=0
        if system_shutdown_in_progress; then
            system_shutdown=1
            if printer_command_available; then
                printer_command "action:forge_x_shutting_down"
                sleep 1
            fi
        fi

        run_logged stop
        status=$?

        if [ "$system_shutdown" -eq 0 ] && printer_command_available; then
            printer_command "action:forge_x_redraw"
        fi
    ;;

    restart|reload)
        run_logged restart
        status=$?
    ;;

    *)
        echo "Usage: $0 {start|stop|restart|reload}"
        status=1
    ;;
esac

exit "$status"
