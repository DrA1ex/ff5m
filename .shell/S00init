# This installed file is the last-known-good early trust boundary. Keep mutable
# recovery details in recovery.sh and normal runtime work in init-main.sh.

BOOT_FAILURE_F=/opt/config/mod/BOOT_FLAG_FAILURE
BOOT_SKIP_F=/opt/config/mod/BOOT_FLAG_SKIP
BOOT_RECOVERY_FAILURE_F=/opt/config/mod/BOOT_FLAG_RECOVERY_FAILURE
SKIP_MOD_F=/tmp/SKIP_MOD
SKIP_MOD_SOFT_F=/tmp/SKIP_MOD_SOFT
SKIP_MOD_HARD_F=/tmp/SKIP_MOD_HARD
INIT_FLAG=/tmp/init_finished_f
BOOT_REASON_F=/tmp/forge_x_boot_reason

RECOVERY_SCRIPT=/opt/config/mod/.shell/boot/recovery.sh
INIT_MAIN_SCRIPT=/opt/config/mod/.shell/init-main.sh
GUARD_SOURCE=/opt/config/mod/.shell/S00init
INSTALLED_GUARD=/etc/init.d/S00init

SKIP_IMAGE=/opt/config/mod/skip.img.xz
BOOT_IMAGE=/root/boot.img
FRAMEBUFFER=/dev/fb0
INIT_MAIN_SPECIAL_BOOT=10

publish_hard_skip() {
    local reason="$1"

    touch "$SKIP_MOD_HARD_F" || return 1
    printf '?? %s\n' "$reason" > "$BOOT_REASON_F" 2>/dev/null || true
    rm -f "$SKIP_MOD_F" "$SKIP_MOD_SOFT_F" "$INIT_FLAG"
}

fail_boot() {
    publish_hard_skip "$1" || return 1
    sync
    rm -f "$BOOT_FAILURE_F"
    sync
}

handle_boot_options() {
    if [ -f "$BOOT_RECOVERY_FAILURE_F" ]; then
        if publish_hard_skip "Recovery was interrupted."; then
            sync
            rm -f "$BOOT_RECOVERY_FAILURE_F" "$BOOT_SKIP_F" "$BOOT_FAILURE_F"
            sync
        fi

        echo "Recovery was interrupted."
        echo "Starting stock firmware."
        echo "Forge-X is fully bypassed."
        return 0
    fi

    if [ -f "$BOOT_SKIP_F" ]; then
        if ! touch "$BOOT_RECOVERY_FAILURE_F"; then
            publish_hard_skip "Recovery could not start safely."
            sync
            echo "Unable to arm recovery."
            echo "Starting stock firmware."
            return 0
        fi

        sync

        if ! publish_hard_skip "Recovery is starting."; then
            echo "Unable to enter recovery safely."
            echo "Starting stock firmware."
            return 0
        fi

        sync
        rm -f "$BOOT_SKIP_F" "$BOOT_FAILURE_F"
        sync

        echo "Starting Forge-X recovery."
        echo "An interrupted recovery starts stock."
        if ! "$RECOVERY_SCRIPT"; then
            if ! publish_hard_skip "Recovery exited with an error."; then
                echo "Unable to publish Stock Only mode."
                return 0
            fi

            sync
            echo "Forge-X recovery failed."
            echo "Starting stock firmware."
        else
            rm -f "$BOOT_REASON_F"
        fi

        rm -f "$BOOT_RECOVERY_FAILURE_F"
        sync
        return 0
    fi

    if [ -f "$BOOT_FAILURE_F" ]; then
        fail_boot "Previous Forge-X initialization was interrupted."

        echo "Forge-X initialization did not finish."
        echo "Starting stock firmware."
        echo "Forge-X is fully bypassed."
        return 0
    fi

    return 1
}

commit_boot_guard() {
    local candidate="${INSTALLED_GUARD%/*}/.S00init.$$"

    /bin/bash -n "$GUARD_SOURCE" || return 1
    rm -f "${INSTALLED_GUARD%/*}"/.S00init.* || return 1

    if [ ! -L "$INSTALLED_GUARD" ] && cmp -s "$GUARD_SOURCE" "$INSTALLED_GUARD"; then
        return 0
    fi

    cp -f "$GUARD_SOURCE" "$candidate" || return 1

    chmod 755 "$candidate" || {
        rm -f "$candidate"
        return 1
    }

    if ! /bin/bash -n "$candidate"; then
        rm -f "$candidate"
        return 1
    fi

    sync || {
        rm -f "$candidate"
        return 1
    }

    if ! mv -f "$candidate" "$INSTALLED_GUARD"; then
        rm -f "$candidate"
        return 1
    fi

    sync
}

start_normal_boot() {
    local status

    export FIRMWARE_INSTALL_PARENT_PID="$PPID"

    if handle_boot_options; then
        return 0
    fi

    if [ -f "$SKIP_MOD_F" ] || [ -f "$SKIP_MOD_SOFT_F" ] || [ -f "$SKIP_MOD_HARD_F" ]; then
        echo "A stock boot mode is already selected."
        return 0
    fi

    if [ -f "$INIT_FLAG" ]; then
        echo "Forge-X is already initialized."
        return 1
    fi

    rm -f "$BOOT_REASON_F"

    # Arm the recovery trigger before any optional display work.
    if ! touch "$BOOT_SKIP_F"; then
        publish_hard_skip "Recovery trigger could not be armed."
        sync
        return 0
    fi

    sync

    xzcat "$SKIP_IMAGE" > "$FRAMEBUFFER" 2>/dev/null || true
    sleep 3

    # The overlap is intentional: BOOT_SKIP has priority if power is lost
    # before the durable transition to BOOT_FAILURE completes.
    if ! touch "$BOOT_FAILURE_F"; then
        publish_hard_skip "Boot safety marker could not be armed."
        sync
        return 0
    fi

    sync
    rm -f "$BOOT_SKIP_F"
    sync

    cat "$BOOT_IMAGE" > "$FRAMEBUFFER" 2>/dev/null || true

    "$INIT_MAIN_SCRIPT" start
    status=$?
    case "$status" in
        0)
            if [ ! -f "$INIT_FLAG" ]; then
                fail_boot "Forge-X initialization did not become ready."

                echo "Forge-X initialization returned without publishing readiness."
                return 0
            fi

            commit_boot_guard || echo "Unable to update the installed Forge-X boot guard."
        ;;

        "$INIT_MAIN_SPECIAL_BOOT")
            rm -f "$BOOT_FAILURE_F"
            sync
        ;;

        *)
            fail_boot "Forge-X initialization failed."

            echo "Forge-X initialization failed."
            echo "Starting stock firmware."
        ;;
    esac

    unset FIRMWARE_INSTALL_PARENT_PID
    return 0
}

boot_guard_main() {
    case "$1" in
        start) start_normal_boot ;;

        *)
            echo "Usage: $0 start"
            return 1
        ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    boot_guard_main "$@"
    exit $?
fi
