#!/bin/sh

. /opt/config/mod/.shell/boot/boot_mode.sh || exit 0
BOOT_MODE=$(forge_x_boot_mode)

PID_FILE=/run/dropbear.pid

start() {
    DROPBEAR_ARGS="-p 22"
    [ -r /etc/default/dropbear ] && . /etc/default/dropbear

    printf "Starting dropbear: "
    start-stop-daemon -Sbm -p "$PID_FILE" --exec /bin/dropbear -- -F $DROPBEAR_ARGS
    status=$?
    [ "$status" -eq 0 ] && echo "OK" || echo "FAIL"
    return "$status"
}

stop() {
    printf "Stopping dropbear: "
    start-stop-daemon -K -p $PID_FILE > /dev/null 2>&1
    status=$?
    [ "$status" -eq 0 ] && echo "OK" || echo "FAIL"
    return "$status"
}

case "$1:$BOOT_MODE" in
    start:mod|start:stock-soft|recovery-start:*)
        start
    ;;

    stop:*)
        stop
    ;;

    restart:mod|restart:stock-soft|reload:mod|reload:stock-soft)
        stop
        start
    ;;

    start:*|restart:*|reload:*)
        echo "Dropbear disabled in $BOOT_MODE mode"
    ;;

    *)
        echo "Usage: $0 {start|stop|restart|reload|recovery-start}"
        exit 1
    ;;
esac
