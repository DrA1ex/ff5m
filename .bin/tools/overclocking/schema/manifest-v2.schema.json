    "cpu1248": {
      "allOf": [
        {
          "$ref": "#/$defs/cpuBase"
        },
        {
          "properties": {
            "alias": {
              "const": "1.25"
            },
            "accepted_aliases": {
              "const": "1248"
            },
            "exact_mhz": {
              "const": 1248
            },
            "exact_hz": {
              "const": 1248000000
