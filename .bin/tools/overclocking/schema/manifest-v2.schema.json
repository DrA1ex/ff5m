    "hardwareBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family_id",
        "models",
        "frequencies_mhz",
        "runtime"
      ],
      "properties": {
        "kind": {
          "const": "hardware_family"
        },
        "family_id": {
          "type": "string"
        },
        "models": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}:[0-9a-f]{4}:[0-9a-f]{12}:[0-9a-f]{2}(,[0-9a-f]{2}:[0-9a-f]{4}:[0-9a-f]{12}:[0-9a-f]{2})*$",
          "description": "Supported MMC v2+ model/revision identities: MID:OEM:PNM-hex:PRV. Exact field values, no specimen serial/date/CRC and no wildcard revisions. Support is not individual frequency certification; explicit trial and verification remain mandatory."
        },
        "frequencies_mhz": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      }
    },
    "hs200": {
      "allOf": [
        {
          "$ref": "#/$defs/hardwareBase"
