{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-x.invalid/schema/t113-profilectl-manifest-v2.schema.json",
  "title": "Forge-X T113 profilectl manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "name",
    "generator_version",
    "validator_version",
    "canonical_stock",
    "boot",
    "stock_environment",
    "cpu",
    "thermal",
    "voltage",
    "hardware"
  ],
  "properties": {
    "format": {
      "const": 2
    },
    "name": {
      "const": "t113-profilectl"
    },
    "generator_version": {
      "const": "1.0.1"
    },
    "validator_version": {
      "const": 6
    },
    "canonical_stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "fdt_version",
        "size"
      ],
      "properties": {
        "file": {
          "const": "profiles/source/sunxi-stock.dtb"
        },
        "sha256": {
          "const": "27501dc48c5ad4c71e3a12742e3ef2a162d6a2d8285bbbac82488c7fade79e21"
        },
        "fdt_version": {
          "const": 17
        },
        "size": {
          "const": 55093
        }
      }
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uimage_address",
        "dtb_address",
        "minimum_padding",
        "stock_bootcmd",
        "slots"
      ],
      "properties": {
        "uimage_address": {
          "const": "0x43000000"
        },
        "dtb_address": {
          "const": "0x44864e70"
        },
        "minimum_padding": {
          "const": 32768
        },
        "stock_bootcmd": {
          "const": "run setargs_mmc boot_dsp0 boot_uImage"
        },
        "slots": {
          "const": [
            "FORGE_X_A.DTB",
            "FORGE_X_B.DTB"
          ]
        }
      }
    },
    "cpu": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/cpuBase"
      },
      "uniqueItems": true,
      "description": "The seven managed T113 modes. Aliases and warning text are manifest data; host tests check agreement with the profilectl CLI."
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passive_mc",
        "hysteresis_mc",
        "critical_mc",
        "cooling_floor_hz",
        "sensor_path",
        "sensor_index"
      ],
      "properties": {
        "passive_mc": {
          "const": 70000
        },
        "hysteresis_mc": {
          "const": 2000
        },
        "critical_mc": {
          "const": 90000
        },
        "cooling_floor_hz": {
          "const": 1008000000
        },
        "sensor_path": {
          "const": "/soc@3000000/ths@02009400"
        },
        "sensor_index": {
          "const": 0
        }
      }
    },
    "voltage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed_opp_microvolt"
      ],
      "properties": {
        "managed_opp_microvolt": {
          "const": 950000
        }
      }
    },
    "hardware": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/hs200"
        },
        {
          "$ref": "#/$defs/legacy"
        }
      ],
      "items": false
    },
    "stock_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file"
      ],
      "properties": {
        "id": {
          "const": "ad5m-stock-v1"
        },
        "file": {
          "const": "profiles/source/stock-uboot.env"
        }
      }
    }
  },
  "$defs": {
    "cpuBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "alias",
        "accepted_aliases",
        "exact_mhz",
        "exact_hz"
      ],
      "properties": {
        "kind": {
          "const": "cpu_axis"
        },
        "alias": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "accepted_aliases": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(,[0-9]+(\\.[0-9]+)?)*$"
        },
        "exact_mhz": {
          "type": "integer",
          "enum": [
            1104,
            1152,
            1200,
            1248,
            1296,
            1344,
            1392
          ]
        },
        "exact_hz": {
          "type": "integer",
          "minimum": 1104000000,
          "maximum": 1392000000,
          "multipleOf": 48000000
        },
        "warning": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "exact_mhz": {
            "const": 1392
          }
        }
      },
      "then": {
        "required": [
          "warning"
        ]
      }
    },
    "hardwareBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family_id",
        "models",
        "frequencies_mhz",
        "runtime"
      ],
      "properties": {
        "kind": {
          "const": "hardware_family"
        },
        "family_id": {
          "type": "string"
        },
        "models": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}:[0-9a-f]{4}:[0-9a-f]{12}:[0-9a-f]{2}(,[0-9a-f]{2}:[0-9a-f]{4}:[0-9a-f]{12}:[0-9a-f]{2})*$",
          "description": "Supported MMC v2+ model/revision identities: MID:OEM:PNM-hex:PRV. Exact field values, no specimen serial/date/CRC and no wildcard revisions. Support is not individual frequency certification; explicit trial and verification remain mandatory."
        },
        "frequencies_mhz": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      }
    },
    "hs200": {
      "allOf": [
        {
          "$ref": "#/$defs/hardwareBase"
        },
        {
          "properties": {
            "family_id": {
              "const": "hs2001v8"
            },
            "frequencies_mhz": {
              "const": "25,50,100,150"
            },
            "runtime": {
              "const": "HS200,1.8V"
            }
          },
          "required": [
            "family_id",
            "models",
            "frequencies_mhz",
            "runtime"
          ]
        }
      ]
    },
    "legacy": {
      "allOf": [
        {
          "$ref": "#/$defs/hardwareBase"
        },
        {
          "properties": {
            "family_id": {
              "const": "legacy3v3"
            },
            "frequencies_mhz": {
              "const": "25,50"
            },
            "runtime": {
              "const": "legacy-or-HS52,3.3V"
            }
          },
          "required": [
            "family_id",
            "models",
            "frequencies_mhz",
            "runtime"
          ]
        }
      ]
    }
  }
}
