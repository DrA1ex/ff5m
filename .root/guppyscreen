case "$1" in
    start)
        echo "Starting Guppy screen..."
        /opt/config/mod/.root/S35tslib start
        /opt/config/mod/.root/S80guppyscreen start
        echo "Guppy screen started"
    ;;
    
    stop)
        echo "Stopping Guppy screen..."
        /opt/config/mod/.root/S80guppyscreen stop
        echo "Guppy screen stopped"
    ;;
    
    restart)
        echo "Restarting Guppy screen..."
        /opt/config/mod/.root/S35tslib start
        /opt/config/mod/.root/S80guppyscreen restart
        echo "Guppy screen restarted"
    ;;
    
    *)
        echo "Usage: $0 {start|stop|restart}"
        echo ""
        echo "Commands:"
        echo "  start   - Start the Guppy screen"
        echo "  stop    - Stop the Guppy screen"
        echo "  restart - Restart the Guppy screen"
        exit 1
    ;;
esac

exit $?
