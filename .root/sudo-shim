if [ "$#" -eq 1 ]; then
    case "$1" in
        reboot) printer_command=REBOOT ;;
        poweroff) printer_command=SHUTDOWN ;;
    esac
fi

if [ -n "$printer_command" ] \
        && [ -e /tmp/printer ] \
        && ps | grep -q "[k]lippy.py"; then
    if printf '%s\n' "$printer_command" > /tmp/printer; then
        exit 0
    fi
fi

exec "$@"
