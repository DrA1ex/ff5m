BIN=/usr/bin/ts_uinput
PIDFILE=/run/ts_uinput.pid
NICENESS=9

# variables must be present or ts_uinput will fail.

export TSLIB_TSDEVICE=/dev/input/event0
export TSLIB_PLUGINDIR=/usr/lib/ts
export TSLIB_CONFFILE=/etc/ts.conf
export TSLIB_CALIBFILE=/etc/pointercal
export TSLIB_FBDEVICE=/dev/fb0

create_link() {
    attempts="${1:-1}"

    while [ "$attempts" -gt 0 ]; do
        DEVICE=$(grep -l "ts_uinput" /sys/class/input/event*/device/name | head -n 1)
        [ -n "$DEVICE" ] && break

        attempts=$((attempts - 1))
        [ "$attempts" -gt 0 ] && sleep 0.1
    done

    if [ -z "$DEVICE" ]; then
        echo "Unable to obtain input device."
        return 1
    fi

    DEVICE=${DEVICE%/device/name}
    DEVICE="/dev/input/${DEVICE##*/}"

    ln -fns "$DEVICE" /dev/input/fgx_touch
    # Guppy still uses this compatibility name.
    ln -fns /dev/input/fgx_touch /dev/input/guppy
}

running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    echo "Starting tslib uinput interface..."

    if running; then
        create_link
        echo "Already running"
        return 0
    fi
    
    # First start
    if ! lsmod | grep -q uinput; then
        insmod /lib/modules/5.4.61/uinput.ko
        
        mkdir -p /tmp/parent_root
        mount /dev/mmcblk0p6 /tmp/parent_root
        
        ln -fns /tmp/parent_root/opt/tslib-1.12/etc/ts.conf /etc/
        ln -fns /tmp/parent_root/opt/tslib-1.12/etc/pointercal /etc/
    fi
    
    if start-stop-daemon -S -q -b -m -p $PIDFILE -N $NICENESS --exec $BIN && create_link 50; then
        echo "OK"
    else
        echo "FAIL"
        return 1
    fi
}

stop() {
    echo "Stopping tslib uinput interface..."
    start-stop-daemon -K -q -p $PIDFILE

    # Keep the PID and device names until the daemon has released the device.
    attempts=50
    while running; do
        [ "$attempts" -gt 0 ] || { echo "FAIL"; return 1; }
        attempts=$((attempts - 1))
        sleep 0.1
    done

    rm -f "$PIDFILE" /dev/input/fgx_touch /dev/input/guppy
    echo "OK"
}

restart() {
    stop && start
}

case "$1" in
    start)
        start
    ;;
    stop)
        stop
    ;;
    restart|reload)
        restart
    ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
